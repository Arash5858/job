#!/usr/bin/env python3

import argparse
import time
import requests
from datetime import datetime


def check_service(url: str, timeout: int = 5) -> dict:
    start = time.perf_counter()

    try:
        response = requests.get(url, timeout=timeout)
        latency = (time.perf_counter() - start) * 1000

        return {
            "url": url,
            "status": response.status_code,
            "latency": round(latency, 2),
            "online": response.ok,
        }

    except requests.RequestException as error:
        return {
            "url": url,
            "status": None,
            "latency": None,
            "online": False,
            "error": str(error),
        }


def main():
    parser = argparse.ArgumentParser(
        description="PulseForge - Lightweight API health monitor"
    )

    parser.add_argument(
        "urls",
        nargs="+",
        help="One or more URLs to monitor"
    )

    parser.add_argument(
        "--interval",
        type=int,
        default=10,
        help="Seconds between checks (default: 10)"
    )

    args = parser.parse_args()

    print("PulseForge | Service Monitor")
    print("-" * 50)

    while True:
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        for url in args.urls:
            result = check_service(url)

            if result["online"]:
                print(
                    f"[{timestamp}] "
                    f"UP   {url} | "
                    f"{result['status']} | "
                    f"{result['latency']} ms"
                )
            else:
                print(
                    f"[{timestamp}] "
                    f"DOWN {url} | "
                    f"{result.get('error', 'HTTP error')}"
                )

        print("-" * 50)
        time.sleep(args.interval)


if __name__ == "__main__":
    main()
